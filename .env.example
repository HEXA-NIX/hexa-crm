DATABASE_URL=postgresql://hakos:nix_password@127.0.0.1:5432/nix_crm
# Base de datos externa por tienda (no la guardes en tenant_plugins ni en el navegador).
# HEXA_PLUGIN_DATABASE_SHOP_URL=postgresql://usuario:password@host:5432/tienda
# Web data plane: local uses browser localStorage; central uses /api/rpc + PostgreSQL.
# Defaults: local in vite dev, central in production builds.
# VITE_CRM_MODE=local
# JSON backup upload limit for the Node web adapter (default is 512K).
# BODY_SIZE_LIMIT=10M
# Central API: set POSTGRES_PASSWORD in the Incus secret store, never commit it.
# HEXA_SERVICE_KEYS='[{"keyId":"meiga-2026-07","tenantCode":"MEIGA","secret":"rotate-in-secret-store"}]'
# HEXA_CENTRAL_MODE=1 # no demo seed; provision tenants explicitly
# HEXA_MIGRATION_TOKEN=store-outside-repo  # owner-only POST /api/v1/admin/migrate
# npm run central:provision-tenant  # with DATABASE_URL, HEXA_TENANT_CODE=MEIGA and legal/trade names
# npm run central:provision-api-role  # with owner DATABASE_URL and HEXA_API_DB_USER/PASSWORD
# npm run central:provision-operator  # with owner DATABASE_URL, tenant and operator credentials
# HEXA_API_DATABASE_URL=postgresql://hexa_api:secret@db:5432/hexa_crm
# HEXA_OLLAMA_URL=http://ollama.internal:11434
# HEXA_OLLAMA_MODEL=llama3.2-vision
# HEXA_EMBEDDING_MODEL=nomic-embed-text
# Google Drive OAuth (configuración del operador, nunca del cliente final).
# GOOGLE_DRIVE_CLIENT_ID=...
# GOOGLE_DRIVE_CLIENT_SECRET=...
# GOOGLE_DRIVE_REDIRECT_URI=https://crm.example.com/api/storage/google-drive/callback
# HEXA_MASTER_ENCRYPTION_KEY=generate-a-long-random-secret
# GOWA (WhatsApp Web multi-dispositivo, servicio interno)
GOWA_BASE_URL=http://127.0.0.1:3000
GOWA_USERNAME=
GOWA_PASSWORD=
GOWA_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
VITE_PUBLIC_APP_URL=http://10.0.10.4:1420
# URL pública HTTPS que se envía por WhatsApp (no uses localhost en producción).
# Debe apuntar al CRM accesible desde el móvil para que funcione la previsualización.
HEXA_PUBLIC_APP_URL=https://crm.example.com
